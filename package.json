{
  "name": "pantheon",
  "version": "1.0.0",
  "description": "JSON-first, auditable, rollback-capable software engineering compiler",
  "main": "dist/src/index.js",
  "type": "module",
  "bin": {
    "pantheon": "./src/cli/pantheon.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "serve": "npx tsx src/server.ts",
    "pantheon": "npx tsx src/cli/pantheon.ts",
    "pantheon:agent-doctor": "node dist/src/cli/pantheon.js agent doctor"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "fast-json-stable-stringify": "^2.1.0",
    "fastify": "^5.8.5",
    "zod": "^4.3.6"
  }
}
